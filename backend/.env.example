# Spring Boot Environment Variables Configuration Template
# Copy this file to .env or set these in your hosting environment (e.g. Render, Railway, AWS, VPS)

# Server port (default 8080)
PORT=8080

# Active Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/portfolio_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# Allowed Frontend Origins (comma separated)
FRONTEND_URL=http://localhost:5173,http://localhost:3000,https://your-portfolio-domain.vercel.app

# Optional Admin Authentication Key for retrieving messages
ADMIN_KEY=your-admin-secret-key-change-me
